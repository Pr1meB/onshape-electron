{
  "name": "onshape-cad",
  "productName": "Onshape CAD",
  "version": "1.0.0",
  "description": "Desktop Wrapper for Onshape 3D CAD",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder"
  },
  "author": "pr1meb <pr1meb@example.com>",
  "homepage": "https://cad.onshape.com",
  "dependencies": {
    "electron-window-state": "^5.0.3",
    "jimp": "^0.16.1"
  },
  "build": {
    "appId": "com.pr1meb.onshape",
    "linux": {
      "target": "deb",
      "category": "Graphics",
      "executableName": "onshape-cad"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
